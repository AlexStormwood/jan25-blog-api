{
  "name": "jan25-blog-api",
  "version": "1.0.0",
  "description": "Blog API for the \"ExpressJS Build an API\" Ed content.",
  "main": "index.js",
  "scripts": {
    "start": "node ./src/index.js",
    "dev:watch": "node --watch ./src/index.js",
    "dev:db:seed": "node ./src/utils/_dev/dbSeed.js",
    "dev:db:wipe": "node ./src/utils/_dev/dbWipe.js",
    "dev:db:wipe-and-seed": "npm run dev:db:wipe && npm run dev:db:seed",
    "dev:env": "node ./src/utils/_dev/envSetup.js",
    "test": "jest --detectOpenHandles",
    "test:coverage": "jest --coverage",
    "test:ci":"jest --ci --reporters=default --reporters=jest-junit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexStormwood/jan25-blog-api.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/AlexStormwood/jan25-blog-api/issues"
  },
  "homepage": "https://github.com/AlexStormwood/jan25-blog-api#readme",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.2.4"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "jest-junit": "^17.0.0",
    "supertest": "^7.2.2"
  },
  "jest-junit": {
    "suiteNameTemplate": "{filepath}",
    "classNameTemplate": "{classname}",
    "titleTemplate": "{title}",
    "outputDirectory":"test-results"
  }
}
